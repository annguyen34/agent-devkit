{
  "name": "agent-devkit",
  "version": "0.1.1",
  "description": "CLI toolkit for structured AI-assisted development with Claude Code, Cursor, and GitHub Copilot",
  "main": "dist/cli.js",
  "bin": {
    "agent-devkit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",

    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "templates",
    "registry.json",
    "skills"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "inquirer": "^9.3.7",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Nguyen Dang <annguyen34.work@gmail.com>"
}